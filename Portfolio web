import customtkinter as ctk
from PIL import Image
import os

ctk.set_appearance_mode('light')

BASE_DIR= os.path.dirname(os.path.abspath(__file__))

class MyApp:
    def __init__(self,root):
        self.root=root
        self.root.geometry('1050x650')
        self.root.title('My Portfolio')
        self.root.configure(fg_color='white')

        self.create_navbar()
        self.create_hero()


    def create_navbar(self):
        self.nav=ctk.CTkFrame(self.root,fg_color='#14b8a6',height=55,corner_radius=0)
        self.nav.pack(fill='x')

        ctk.CTkLabel(self.nav,text='My Portfolio',text_color='white',font=('Arial',17,'bold')).pack(side='left',padx=25)

        for text in ['Contact','About','Home']:
            ctk.CTkLabel(self.nav,text=text,text_color='white',font=('Arial',13,)).pack(side='right',padx=15)


    def create_hero(self):
        self.hero=ctk.CTkFrame(self.root,fg_color='#ecfdf5',corner_radius=0)
        self.hero.pack(fill='both',expand=True)

        ctk.CTkLabel(self.hero,text="Hello I'm ",text_color='#64748b',font=('Arial',14)).place(x=60,y=80)

        ctk.CTkLabel(self.hero,text='Yaira',text_color='black',font=('Arial',35,'bold')).place(x=60,y=110)

        ctk.CTkLabel(self.hero,text='Developer and Graphic Designer from Rajasthan',text_color='grey',font=('Arial',14)).place(x=60,y=170)

        ctk.CTkButton(self.hero,text='Hire Me',fg_color='#14b8a6',corner_radius=20,width=120).place(x=60,y=230)

        ctk.CTkButton(self.hero,text='See My Resume',fg_color='white',text_color='#14b8a6',border_width=1,border_color='#14b8a6',
                      corner_radius=20,width=140).place(x=190,y=230)


        image_path= os.path.join(BASE_DIR,'photo.png')
        if not os.path.exists(image_path):
            image_path= os.path.join(BASE_DIR,'photo.jpg')

        if os.path.exists(image_path):
            my_img= ctk.CTkImage(Image.open(image_path),size=(500,590))
            ctk.CTkLabel(self.hero,image=my_img,text='',fg_color='transparent',bg_color='transparent').place(relx=1.0,rely=1.0,anchor='se',x=-20,y=0)

        else:
            ctk.CTkLabel(self.hero,text='',width=320,height=320,fg_color='#14b8a6',
                        corner_radius=160,text_color='white',font=('Arial',14,'bold')).place(x=650,y=80)

        








if __name__=="__main__":
    window=ctk.CTk()
    app=MyApp(window)
    window.mainloop()
